{
  "name": "convo-vault",
  "version": "0.8.3",
  "private": true,
  "description": "Local-first ChatGPT conversation exporter with local rendering and portable archives.",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:fixtures": "node --test tests/export-fixtures.test.mjs tests/backend-fixtures.test.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "backend": "node scripts/start-local-backend.mjs",
    "backend:detached": "node scripts/start-local-backend.mjs --detached",
    "backend:check": "node scripts/check-local-backend.mjs",
    "knowledge:init": "node tools/knowledge-pack/cli.mjs init",
    "knowledge:import": "node tools/knowledge-pack/cli.mjs import",
    "knowledge:catalog": "node tools/knowledge-pack/catalog.mjs catalog",
    "knowledge:validate-links": "node tools/knowledge-pack/validate-links.mjs",
    "knowledge:review-audit": "node tools/knowledge-pack/review-audit.mjs",
    "knowledge:process": "node tools/knowledge-pack/processor.mjs process",
    "test:knowledge": "node --test tests/knowledge-pack.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
