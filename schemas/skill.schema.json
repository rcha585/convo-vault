{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convo-vault.dev/schemas/skill.schema.json",
  "title": "Evidence-backed skill",
  "type": "object",
  "required": ["schema_version", "id", "name", "maturity", "purpose", "evidence_ids", "policy"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "maturity": { "enum": ["idea", "draft", "tested", "approved", "deprecated"] },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "checks": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "test_case_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "policy": { "$ref": "common.schema.json#/$defs/policy" },
    "public_export": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
