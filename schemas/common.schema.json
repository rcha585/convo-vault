{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convo-vault.dev/schemas/common.schema.json",
  "title": "Convo Vault common definitions",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "ownership": { "enum": ["user-authored", "user-work", "third-party", "conversation", "ai-generated", "mixed", "unknown"] },
    "privacy": { "enum": ["public", "private", "confidential", "restricted"] },
    "sourceMode": { "enum": ["external-index", "snapshot", "synthetic"] },
    "allowedUse": { "enum": ["archive", "search", "retrieval", "summarize", "style-analysis", "reasoning-analysis", "skill-derivation", "training", "public-share"] },
    "trainingPolicy": { "enum": ["prohibited", "retrieval-only", "review-required", "approved", "synthetic-only"] },
    "evidenceStrength": { "enum": ["direct", "corroborated", "inferred", "user-confirmed", "unverified"] },
    "processingStatus": { "enum": ["cataloged", "imported", "processing", "needs-review", "processed", "approved", "rejected", "failed"] },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "policy": {
      "type": "object",
      "required": ["privacy", "allowed_uses", "training_policy"],
      "properties": {
        "privacy": { "$ref": "#/$defs/privacy" },
        "allowed_uses": { "type": "array", "items": { "$ref": "#/$defs/allowedUse" }, "uniqueItems": true },
        "training_policy": { "$ref": "#/$defs/trainingPolicy" }
      },
      "additionalProperties": false
    }
  }
}
