{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convo-vault.dev/schemas/knowledge-item.schema.json",
  "title": "Knowledge item",
  "type": "object",
  "required": ["schema_version", "id", "kind", "title", "status", "evidence_ids", "policy"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "kind": { "enum": ["concept", "claim", "experience", "project", "topic", "entity", "timeline-event", "decision", "question"] },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string" },
    "status": { "enum": ["draft", "needs-review", "approved", "rejected", "superseded"] },
    "ownership": { "$ref": "common.schema.json#/$defs/ownership" },
    "evidence_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "related_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "policy": { "$ref": "common.schema.json#/$defs/policy" },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updated_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
