{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convo-vault.dev/schemas/conversation.schema.json",
  "title": "Conversation",
  "type": "object",
  "required": ["schema_version", "id", "platform", "title", "messages"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "platform": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "source_url": { "type": ["string", "null"] },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "exported_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "position", "role", "content"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "source_message_id": { "type": ["string", "null"] },
          "position": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["user", "assistant", "system", "tool", "unknown"] },
          "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
          "content": { "type": "string" },
          "attachment_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true }
        },
        "additionalProperties": false
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "availability"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "media_type": { "type": ["string", "null"] },
          "availability": { "enum": ["present", "reference-only", "not-in-snapshot", "unknown"] },
          "relative_path": { "type": ["string", "null"] },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
