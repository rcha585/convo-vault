{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convo-vault.dev/schemas/source-item.schema.json",
  "title": "Source item",
  "type": "object",
  "required": ["schema_version", "id", "type", "title", "source_class", "ownership", "source_mode", "policy", "processing_status"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "enum": ["conversation", "document", "spreadsheet", "presentation", "pdf", "image", "audio", "video", "archive", "dataset", "other"] },
    "title": { "type": "string", "minLength": 1 },
    "source_class": { "type": "string", "minLength": 1 },
    "ownership": { "$ref": "common.schema.json#/$defs/ownership" },
    "source_mode": { "$ref": "common.schema.json#/$defs/sourceMode" },
    "original_path": { "type": ["string", "null"] },
    "portable_uri": { "type": ["string", "null"] },
    "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "modified_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "content_date": { "type": ["string", "null"] },
    "date_basis": { "enum": ["embedded", "filename", "filesystem", "user-confirmed", "unknown"] },
    "policy": { "$ref": "common.schema.json#/$defs/policy" },
    "processing_status": { "$ref": "common.schema.json#/$defs/processingStatus" },
    "relationships": { "type": "array", "items": { "type": "object", "required": ["type", "target_id"], "properties": { "type": { "type": "string" }, "target_id": { "$ref": "common.schema.json#/$defs/id" } }, "additionalProperties": false } },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
