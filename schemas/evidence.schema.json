{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convo-vault.dev/schemas/evidence.schema.json",
  "title": "Evidence link",
  "type": "object",
  "required": ["schema_version", "id", "source_id", "strength", "locator"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "source_id": { "$ref": "common.schema.json#/$defs/id" },
    "strength": { "$ref": "common.schema.json#/$defs/evidenceStrength" },
    "locator": {
      "type": "object",
      "properties": {
        "message_id": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 },
        "sheet": { "type": "string" },
        "range": { "type": "string" },
        "slide": { "type": "integer", "minimum": 1 },
        "section": { "type": "string" },
        "path": { "type": "string" }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "supports": { "enum": ["supports", "contradicts", "context", "uncertain"] },
    "note": { "type": "string" },
    "reviewed_by_user": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}
